<Window x:Class="OdontoTech.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OdontoTech"
        mc:Ignorable="d"
        Title="MainWindow" Height="386" Width="304">
    <Grid Margin="-11,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Label Content="OdontoTech" Height="32" Margin="99,97,0,0" VerticalAlignment="Top" Width="120" Foreground="#FF07608E" FontFamily="Cambria" HorizontalAlignment="Left" FontSize="20"/>
        <Label Content="Consultório Odontológico" HorizontalAlignment="Left" Height="25" Margin="98,134,0,0" VerticalAlignment="Top" Width="122" FontFamily="Cambria" Foreground="#FF969595" FontSize="10"/>
        <Label Content="E-mail de Acesso:" HorizontalAlignment="Left" Height="20" Margin="25,164,0,0" VerticalAlignment="Top" Width="82" FontSize="9"/>
        <TextBox x:Name="txtemail" HorizontalAlignment="Center" Height="26" Margin="0,189,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="255"/>
        <Label Content="Senha:" HorizontalAlignment="Left" Height="20" Margin="25,220,0,0" VerticalAlignment="Top" Width="40" FontSize="9"/>
        <Button x:Name="BtnEntrar" Content="Entrar no Sistema" HorizontalAlignment="Center" Height="26" Margin="0,291,0,0" VerticalAlignment="Top" Width="255" FontSize="14" FontFamily="Cambria" Background="#FF3085E4" Foreground="White" Click="BtnEntrar_Click"/>
        <PasswordBox x:Name="txtsenha" HorizontalAlignment="Left" Height="26" Margin="25,245,0,0" VerticalAlignment="Top" Width="260"/>

    </Grid>
</Window>
