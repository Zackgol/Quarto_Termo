<Window x:Class="Atividade02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lojadb" Height="450" Width="600">
    <StackPanel Margin="10">

        <TextBlock Text="Nome:" />
        <TextBox x:Name="txtNome" Margin="0,0,0,5" />

        <TextBlock Text="Categoria:" />
        <TextBox x:Name="txtCategoria" Margin="0,0,0,5" />

        <TextBlock Text="Preço:" />
        <TextBox x:Name="txtPreco" Margin="0,0,0,5" />

        <TextBlock Text="Estoque:" />
        <TextBox x:Name="txtEstoque" Margin="0,0,0,5" />

        <Button Content="Inserir Produto" Click="BtnInserir_Click" Margin="0,10,0,5" />
        <Button Content="Atualizar Lista" Click="BtnListar_Click" Margin="0,0,0,10" />

        <DataGrid x:Name="dgProdutos" Height="250" AutoGenerateColumns="True" />
    </StackPanel>
</Window>
