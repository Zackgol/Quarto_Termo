<Application x:Class="Mercado.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgClaro" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="BgPainel" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CorVerde" Color="#2E8B57"/>
        <SolidColorBrush x:Key="TextoEscuro" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#6B6B72"/>

        <Style TargetType="Button" x:Key="BotaoPrimario">
            <Setter Property="Background" Value="{StaticResource CorVerde}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="BotaoSecundario" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="#D8DADF"/>
            <Setter Property="Foreground" Value="#2A2A2E"/>
        </Style>
    </Application.Resources>
</Application>
