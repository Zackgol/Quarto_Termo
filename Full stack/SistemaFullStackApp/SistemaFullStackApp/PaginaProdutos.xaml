<Page x:Class="SistemaFullStackApp.PaginaProdutos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Produtos" Width="598">


    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cadastro e Listagem de Produtos"
            FontSize="20"
            FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgProdutos" Grid.Row="1"
            AutoGenerateColumns="True"
            IsReadOnly="True" GridLinesVisibility="Horizontal"
            AlternatingRowBackground="#F2F2F2" Margin="0,0,0,-188"/>

        <Button Margin="348,0,10,0" Click="btnAbrirNovaJanela_Click" Content="Cadastre aqui!" Background="#FF1A30E6" Foreground="White" BorderBrush="#FF2F2B2B" Height="42" Width="200"/>

    </Grid>
</Page>
