<Page x:Class="SistemaFullStackApp.PaginaProdutos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cadastro e Listagem de Produtos">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Formulário de Entrada -->
            <RowDefinition Height="Auto"/>
            <!-- Botões de Ação -->
            <RowDefinition Height="*"/>
            <!-- DataGrid (Listagem) -->
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Cadastro e Gestão de Produtos" 
                   FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
        <Border Grid.Row="1" Background="#F4F4F9" Padding="15" CornerRadius="8" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ID:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                <TextBox x:Name="txtId" Width="40" IsReadOnly="True" Background="#E0E0E0" Margin="0,0,15,0" 
                            Height="26"/>
                <TextBlock Text="Nome:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtNome" Width="200" Margin="0,0,15,0" Height="26"/>
                <TextBlock Text="Preço (R$):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="txtPreco" Width="80" Margin="0,0,15,0" Height="26"/>
                <TextBlock Text="Estoque:" VerticalAlignment="Center" 
                            Margin="0,0,5,0"/>
                <TextBox x:Name="txtEstoque" Width="60" Margin="0,0,15,0" 
                            Height="26"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    Margin="0,0,0,15">
            <Button x:Name="btnSalvar" Content=" Salvar / Atualizar" 
                    Width="140" Height="32" 
                    Background="#2ECC71" Foreground="White" 
                    FontWeight="Bold" Margin="0,0,10,0" Click="btnSalvar_Click"/>

            <Button x:Name="btnExcluir" Content=" Excluir" Width="100" 
                    Height="32" 
                    Background="#E74C3C" Foreground="White" 
                    FontWeight="Bold" Margin="0,0,10,0" Click="btnExcluir_Click"/>

            <Button x:Name="btnLimpar" Content=" Limpar / Novo" 
                    Width="120" Height="32" 
                    Background="#95A5A6" Foreground="White" 
                    FontWeight="Bold" Click="btnLimpar_Click"/>
        </StackPanel>
        <DataGrid Grid.Row="3" x:Name="dgProdutos" 
                  AutoGenerateColumns="True" 
                  IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="dgProdutos_SelectionChanged">
        </DataGrid>
    </Grid>
</Page>
