<Window x:Class="Mercado.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mercado"
        Height="640" Width="920"
        Background="{StaticResource BgClaro}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="🛒" FontSize="26" Margin="0,0,10,0"/>
            <StackPanel>
                <TextBlock Text="Mercado" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextoEscuro}"/>
                
            </StackPanel>
        </StackPanel>

        <!-- Busca + formulário -->
        <Border Grid.Row="1" Background="{StaticResource BgPainel}" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Busca parametrizada -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Buscar por nome:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEscuro}"/>
                    <TextBox x:Name="TxtBuscaNome" Width="200" Margin="0,0,16,0" Padding="4"/>

                    <TextBlock Text="Categoria:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextoEscuro}"/>
                    <ComboBox x:Name="CmbBuscaCategoria" Width="160" Margin="0,0,16,0"/>

                    <Button Content="Pesquisar" Style="{StaticResource BotaoPrimario}" Click="BtnPesquisar_Click" Margin="0,0,8,0"/>
                    <Button Content="Limpar" Style="{StaticResource BotaoSecundario}" Click="BtnLimparBusca_Click"/>
                </StackPanel>

                <!-- Formulário de adicionar/editar -->
                <TextBlock Text="Produto" FontWeight="Bold" Foreground="{StaticResource TextoEscuro}" Margin="0,0,0,8"/>
                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Nome" Foreground="{StaticResource TextoSecundario}"/>
                        <TextBox x:Name="TxtNome" Padding="5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Categoria" Foreground="{StaticResource TextoSecundario}"/>
                        <TextBox x:Name="TxtCategoria" Padding="5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Preço (R$)" Foreground="{StaticResource TextoSecundario}"/>
                        <TextBox x:Name="TxtPreco" Padding="5" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Estoque" Foreground="{StaticResource TextoSecundario}"/>
                        <TextBox x:Name="TxtEstoque" Padding="5" Margin="0,4,0,0"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock x:Name="TxtErro" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnAdicionar" Content="➕ Adicionar Produto" Style="{StaticResource BotaoPrimario}" Click="BtnAdicionar_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAtualizar" Content="✏️ Atualizar Selecionado" Style="{StaticResource BotaoSecundario}" Click="BtnAtualizar_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnExcluir" Content="🗑️ Excluir Selecionado" Style="{StaticResource BotaoSecundario}" Click="BtnExcluir_Click" Margin="0,0,8,0"/>
                    <Button Content="Limpar Formulário" Style="{StaticResource BotaoSecundario}" Click="BtnLimparFormulario_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Listagem -->
        <DataGrid x:Name="GridProdutos" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="GridProdutos_SelectionChanged"
                  Background="{StaticResource BgPainel}" RowBackground="{StaticResource BgPainel}"
                  Foreground="{StaticResource TextoEscuro}" BorderThickness="1" BorderBrush="#DADCE0"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="0.5*"/>
                <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="2.5*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="1.5*"/>
                <DataGridTextColumn Header="Preço (R$)" Binding="{Binding Preco, StringFormat={}{0:N2}}" Width="1*"/>
                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
