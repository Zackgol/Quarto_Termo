<Window x:Class="CineDiario.Views.PodioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pódio - CineDiário" Height="600" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏆  Pódio" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Dourado}"/>

        <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="8,0">
                <TextBlock x:Name="txtSegundo" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock x:Name="txtSegundoNota" HorizontalAlignment="Center" Foreground="{StaticResource Dourado}" Margin="0,2,0,6"/>
                <Border Height="120" Background="#8C8C8C" CornerRadius="8,8,0,0">
                    <TextBlock Text="2º" FontSize="34" FontWeight="Bold" Foreground="#1A0F12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0">
                <TextBlock x:Name="txtPrimeiro" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontSize="17"/>
                <TextBlock x:Name="txtPrimeiroNota" HorizontalAlignment="Center" Foreground="{StaticResource Dourado}" Margin="0,2,0,6"/>
                <Border Height="170" Background="{StaticResource Dourado}" CornerRadius="8,8,0,0">
                    <TextBlock Text="1º" FontSize="42" FontWeight="Bold" Foreground="#1A0F12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="8,0">
                <TextBlock x:Name="txtTerceiro" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock x:Name="txtTerceiroNota" HorizontalAlignment="Center" Foreground="{StaticResource Dourado}" Margin="0,2,0,6"/>
                <Border Height="85" Background="#B0703C" CornerRadius="8,8,0,0">
                    <TextBlock Text="3º" FontSize="30" FontWeight="Bold" Foreground="#1A0F12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Painel}" CornerRadius="12" Padding="18" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Suas manias de cinéfilo" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtGenero" Margin="0,3"/>
                <TextBlock x:Name="txtDiretor" Margin="0,3"/>
                <TextBlock x:Name="txtLongo" Margin="0,3"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
