<Window x:Class="CineDiario.Views.BuscaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Busca - CineDiário" Height="600" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Fundo}" Foreground="{StaticResource Texto}" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔎  Busca" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Dourado}" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Título ou diretor" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtTexto" KeyDown="Campo_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Gênero" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbGenero"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Ano de" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtAnoDe" KeyDown="Campo_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="até" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtAnoAte" KeyDown="Campo_KeyDown"/>
            </StackPanel>
            <StackPanel Grid.Column="8">
                <TextBlock Text="Situação" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cbSituacao" SelectedIndex="0">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Assistidos"/>
                    <ComboBoxItem Content="Na fila"/>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="10" Content="Pesquisar" Style="{StaticResource BotaoDourado}" VerticalAlignment="Bottom" Click="Pesquisar_Click"/>
        </Grid>

        <TextBlock x:Name="lblResultado" Grid.Row="2" Foreground="{StaticResource TextoSuave}" Margin="0,14,0,8"/>

        <DataGrid x:Name="grade" Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="2*"/>
                <DataGridTextColumn Header="Diretor" Binding="{Binding Diretor}" Width="1.5*"/>
                <DataGridTextColumn Header="Gênero" Binding="{Binding Genero}" Width="*"/>
                <DataGridTextColumn Header="Ano" Binding="{Binding Ano}" Width="60"/>
                <DataGridTextColumn Header="Duração" Binding="{Binding Duracao}" Width="90"/>
                <DataGridTextColumn Header="Nota" Binding="{Binding Estrelas}" Width="90"/>
                <DataGridTextColumn Header="Situação" Binding="{Binding Situacao}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
